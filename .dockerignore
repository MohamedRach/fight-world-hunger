# Keep the build context small and secrets out of the image.

# Secrets — never copy real environment files into an image layer.
.env
.env.*
!.env.example

# Dependencies and build output (reinstalled/rebuilt inside the image)
node_modules
.next
out
build

# Version control and tooling
.git
.gitignore
.github

# Tests and local scratch files
tests
coverage
*.tsbuildinfo
.mock-data

# Editor / OS noise
.vscode
.idea
.DS_Store
Thumbs.db

# Docs and container files (not needed by the build)
docs
README.md
Dockerfile
docker-compose.yml
.dockerignore
npm-debug.log*
