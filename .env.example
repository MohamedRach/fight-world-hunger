# Copy to .env.local and fill in values. Never commit real secrets.
# .env* is git-ignored except this example file.

# ---------------------------------------------------------------------------
# Database (not used yet: the app runs on the in-memory mock store)
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# LLM campaign recommendations (server-side only)
#
# Leave LLM_API_KEY empty to run without a provider: the app then uses the
# deterministic fallback ranking and labels results accordingly.
#
# NEVER prefix any of these with NEXT_PUBLIC_ — that would ship the key to
# the browser. They are read only in src/features/recommendations/server/.
# ---------------------------------------------------------------------------

# Your provider API key. Example placeholder only — put the real one in .env.local.
LLM_API_KEY=

# "openai" (default) or "anthropic".
LLM_PROVIDER=openai

# Defaults: gpt-4o-mini (openai) / claude-3-5-haiku-latest (anthropic).
LLM_MODEL=

# Optional: override for a compatible gateway or proxy.
LLM_BASE_URL=

# Optional: request timeout in milliseconds (default 12000).
LLM_TIMEOUT_MS=
